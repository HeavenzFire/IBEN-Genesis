```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Tests
.pytest_cache/

# Logs
*.log

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Dependencies
.venv/
venv/
pip-log.txt
pip-selfcheck.json

# Build and distribution
build/
dist/
*.egg
*.egg-info/
*.so

# Coverage
.coverage
htmlcov/
.coverage.*

# Temporary files
*.tmp
*~
.DS_Store
Thumbs.db
```